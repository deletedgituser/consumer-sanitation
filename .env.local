# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# MySQL connection string
# Format: mysql://[username]:[password]@[host]:[port]/[database]
# Local development example:
DATABASE_URL="mysql://root:@localhost:3306/sanitation_db"


# ============================================================================
# FASTAPI BACKEND CONFIGURATION
# ============================================================================
# FastAPI backend endpoint (used for direct API calls from admin page)
# NEXT_PUBLIC_ prefix makes it accessible to browser/client code
# For development: http://localhost:8000 (plain HTTP)
# For production: Update to your FastAPI deployment URL
NEXT_PUBLIC_FASTAPI_BASE_URL="http://localhost:8000"
# Application URL for NextAuth callbacks
NEXTAUTH_URL="https://localhost:3000"

# ============================================================================
# SESSION CONFIGURATION  
# ============================================================================
# Session duration in seconds (15 minutes = 900 seconds)
SESSION_MAXAGE=900

# Update age in seconds (refresh session every 5 minutes of activity)
SESSION_UPDATE_AGE=300

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
# development, production, test
NODE_ENV="development"

NEXTAUTH_SECRET=3BXEFcMOfFJ6ejb9NI4XTJ2vjfrUUK+lxEqUTKzyDZ4=

